server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 健康检查：供 Docker HEALTHCHECK 与部署脚本 curl 使用
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # SPA 前端：找不到的路径回退到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
